#!/usr/bin/env bash
# =============================================================================
#  secureprint — convenience wrapper around the SecureDrv tools.
#
#  Ties the three binaries into an everyday workflow:
#     secureprint setup                 one-time: create the master key
#     secureprint print <file> [prn]    encrypt a document into the secure spool
#     secureprint list                  show spooled (encrypted) jobs
#     secureprint release <id> [prn]    decrypt a job and send it to a printer
#     secureprint release-all [prn]     release every spooled job
#     secureprint audit                 verify the audit-log hash chain
#
#  [prn] is an optional CUPS printer name; defaults to your system default.
#
#  Configuration:
#     SECUREDRV_HOME       data dir (default: ~/.local/share/securedrv)
#     passphrase           read from ~/.config/securedrv/passphrase (0600).
#                          Created on first `setup`. Change it any time with:
#                             securedrv-keygen change   (see README)
# =============================================================================
set -euo pipefail

# --- Locate the built binaries relative to this script ----------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="${SECUREDRV_BUILD:-$SCRIPT_DIR/../build}"
DRV="$BUILD_DIR/securedrv"
REL="$BUILD_DIR/securedrv-release"
KEYGEN="$BUILD_DIR/securedrv-keygen"
for b in "$DRV" "$REL" "$KEYGEN"; do
  [ -x "$b" ] || { echo "secureprint: missing binary $b — build the project first" >&2; exit 1; }
done

# --- Persistent data directory + passphrase ---------------------------------
export SECUREDRV_HOME="${SECUREDRV_HOME:-$HOME/.local/share/securedrv}"
PASS_FILE="$HOME/.config/securedrv/passphrase"

load_passphrase() {
  if [ -n "${SECUREDRV_PASSPHRASE:-}" ]; then return; fi
  if [ -f "$PASS_FILE" ]; then
    SECUREDRV_PASSPHRASE="$(cat "$PASS_FILE")"; export SECUREDRV_PASSPHRASE; return
  fi
  echo "secureprint: no passphrase found — run 'secureprint setup' first" >&2
  exit 1
}

cmd="${1:-}"; shift || true
case "$cmd" in
  setup)
    mkdir -p "$(dirname "$PASS_FILE")"; chmod 700 "$(dirname "$PASS_FILE")"
    if [ -f "$PASS_FILE" ]; then
      echo "secureprint: passphrase file already exists at $PASS_FILE"
    else
      # Generate a strong random passphrase and store it locked-down (0600).
      # You may replace its contents with a passphrase you choose, then rotate
      # the on-disk key with: securedrv-keygen change
      umask 077
      head -c 32 /dev/urandom | base64 | tr -d '\n' > "$PASS_FILE"
      chmod 600 "$PASS_FILE"
      echo "secureprint: generated a passphrase at $PASS_FILE (keep it safe)"
    fi
    load_passphrase
    if "$KEYGEN" init --strength moderate 2>/dev/null; then
      echo "secureprint: master key created."
    else
      echo "secureprint: master key already present (leaving it untouched)."
    fi
    ;;

  print)
    [ $# -ge 1 ] || { echo "usage: secureprint print <file> [printer]" >&2; exit 2; }
    load_passphrase
    file="$1"; user="$(whoami)"; title="$(basename "$file")"
    [ -f "$file" ] || { echo "secureprint: no such file: $file" >&2; exit 2; }
    "$DRV" "job" "$user" "$title" 1 "" "$file"
    ;;

  list)
    load_passphrase
    "$REL" list
    ;;

  release)
    [ $# -ge 1 ] || { echo "usage: secureprint release <job-id> [printer]" >&2; exit 2; }
    load_passphrase
    id="$1"; printer="${2:-}"
    if [ -n "$printer" ]; then
      "$REL" release "$id" | lp -d "$printer"
    else
      "$REL" release "$id" | lp
    fi
    ;;

  release-all)
    load_passphrase
    printer="${1:-}"
    # The job table is printed on stderr; capture ids from there.
    ids="$("$REL" list 2>&1 1>/dev/null | awk 'NR>1 && $1 ~ /^[0-9a-f]{32}$/ {print $1}')"
    [ -n "$ids" ] || { echo "secureprint: no jobs to release"; exit 0; }
    for id in $ids; do
      echo "secureprint: releasing $id" >&2
      if [ -n "$printer" ]; then "$REL" release "$id" | lp -d "$printer"
      else "$REL" release "$id" | lp; fi
    done
    ;;

  audit)
    "$REL" verify-audit
    ;;

  *)
    sed -n '2,30p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
